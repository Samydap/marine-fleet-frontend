# Copia este archivo como .env si necesitas apuntar a un backend distinto.
#
# En desarrollo normalmente NO hace falta: vite.config.ts tiene un proxy que
# reenvia /api al backend en http://localhost:3000, asi que el frontend pide al
# mismo origen y no hay CORS.
#
# Usa esta variable solo para apuntar a un backend remoto (staging, por ejemplo).
VITE_API_URL=
